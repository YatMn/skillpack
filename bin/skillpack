#!/usr/bin/env bash
set -euo pipefail

DEFAULT_AGENT="codex"

usage() {
  cat <<'EOF'
Usage:
  skillpack list
  skillpack show <profile>
  skillpack init <profile> [--agent <agent>]
  skillpack add <profile> [--agent <agent>]
  skillpack update
  skillpack restore
  skillpack doctor
  skillpack coverage
EOF
}

die() {
  echo "skillpack: $*" >&2
  exit 1
}

resolve_script_path() {
  local source="${BASH_SOURCE[0]}"
  local dir

  while [ -L "$source" ]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    case "$source" in
      /*) ;;
      *) source="${dir}/${source}" ;;
    esac
  done

  cd -P "$(dirname "$source")" && pwd
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

SCRIPT_DIR="$(resolve_script_path)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
PROFILE_DIR="${ROOT_DIR}/profiles"

profile_path() {
  local profile="$1"

  case "$profile" in
    ""|*/*|*..*) die "invalid profile name: ${profile}" ;;
  esac

  printf '%s/%s.txt' "$PROFILE_DIR" "$profile"
}

require_profile() {
  local profile="$1"
  local path
  if ! path="$(profile_path "$profile")"; then
    return 1
  fi

  [ -f "$path" ] || die "profile not found: ${profile}"
  printf '%s' "$path"
}

list_profiles() {
  local file name

  [ -d "$PROFILE_DIR" ] || die "profile directory not found: ${PROFILE_DIR}"

  for file in "${PROFILE_DIR}"/*.txt; do
    [ -e "$file" ] || continue
    name="$(basename "$file" .txt)"
    printf '%s\n' "$name"
  done
}

profile_skill_names() {
  local file line stripped skills_part skill

  [ -d "$PROFILE_DIR" ] || die "profile directory not found: ${PROFILE_DIR}"

  for file in "${PROFILE_DIR}"/*.txt; do
    [ -e "$file" ] || continue

    while IFS= read -r line || [ -n "$line" ]; do
      stripped="$(trim "${line%%#*}")"
      [ -n "$stripped" ] || continue

      case "$stripped" in
        @*) continue ;;
        *"|"*)
          skills_part="$(trim "${stripped#*|}")"
          for skill in $skills_part; do
            [ -n "$skill" ] && printf '%s\n' "$skill"
          done
          ;;
      esac
    done < "$file"
  done | sort -u
}

local_skill_names() {
  find \
    "${HOME}/.codex/skills" \
    "${HOME}/.agents/skills" \
    "${HOME}/.codex/plugins/cache" \
    -path '*/SKILL.md' \
    -type f 2>/dev/null |
    sed 's#/SKILL.md$##' |
    awk -F/ '{print $NF}' |
    sort -u
}

coverage() {
  local local_file profile_file missing_file extra_file
  local local_count profile_count covered_count missing_count extra_count

  local_file="$(mktemp)"
  profile_file="$(mktemp)"
  missing_file="$(mktemp)"
  extra_file="$(mktemp)"

  local_skill_names > "$local_file"
  profile_skill_names > "$profile_file"

  comm -23 "$local_file" "$profile_file" > "$missing_file"
  comm -13 "$local_file" "$profile_file" > "$extra_file"

  local_count="$(wc -l < "$local_file" | tr -d ' ')"
  profile_count="$(wc -l < "$profile_file" | tr -d ' ')"
  covered_count="$(comm -12 "$local_file" "$profile_file" | wc -l | tr -d ' ')"
  missing_count="$(wc -l < "$missing_file" | tr -d ' ')"
  extra_count="$(wc -l < "$extra_file" | tr -d ' ')"

  echo "local skills: ${local_count}"
  echo "profile skills: ${profile_count}"
  echo "covered local skills: ${covered_count}"
  echo "missing local skills: ${missing_count}"
  echo "profile-only skills: ${extra_count}"

  if [ "$missing_count" -gt 0 ]; then
    echo
    echo "Missing local skills:"
    cat "$missing_file"
  fi

  if [ "$extra_count" -gt 0 ]; then
    echo
    echo "Profile-only skills:"
    cat "$extra_file"
  fi

  rm -f "$local_file" "$profile_file" "$missing_file" "$extra_file"

  [ "$missing_count" -eq 0 ]
}

expand_profile() {
  local profile="$1"
  local stack="${2:-}"
  local path line stripped source skills_part

  case ":${stack}:" in
    *":${profile}:"*) die "profile include cycle: ${stack}:${profile}" ;;
  esac

  if ! path="$(require_profile "$profile")"; then
    return 1
  fi

  while IFS= read -r line || [ -n "$line" ]; do
    stripped="$(trim "${line%%#*}")"
    [ -n "$stripped" ] || continue

    case "$stripped" in
      @*)
        if ! expand_profile "${stripped#@}" "${stack}:${profile}"; then
          return 1
        fi
        ;;
      *"|"*)
        source="$(trim "${stripped%%|*}")"
        skills_part="$(trim "${stripped#*|}")"
        [ -n "$source" ] || die "missing source in ${path}: ${line}"
        [ -n "$skills_part" ] || die "missing skills in ${path}: ${line}"
        printf '%s | %s\n' "$source" "$skills_part"
        ;;
      *)
        die "invalid profile line in ${path}: ${line}"
        ;;
    esac
  done < "$path"
}

parse_agent_args() {
  AGENT="$DEFAULT_AGENT"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --agent)
        shift
        [ "$#" -gt 0 ] || die "--agent requires a value"
        AGENT="$1"
        ;;
      --agent=*)
        AGENT="${1#--agent=}"
        [ -n "$AGENT" ] || die "--agent requires a value"
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
    shift
  done
}

install_profile() {
  local profile="$1"
  local agent="$2"
  local expanded line source skills_part install_file grouped_file
  local -a skills

  if ! expanded="$(expand_profile "$profile")"; then
    return 1
  fi
  [ -n "$expanded" ] || die "profile has no install entries: ${profile}"

  mkdir -p .agents/skills
  install_file="$(mktemp)"
  grouped_file="$(mktemp)"

  while IFS= read -r line || [ -n "$line" ]; do
    source="$(trim "${line%%|*}")"
    skills_part="$(trim "${line#*|}")"
    read -r -a skills <<< "$skills_part"

    [ "${#skills[@]}" -gt 0 ] || die "profile ${profile} has an empty skill list for ${source}"
    case "$source" in
      !*) continue ;;
    esac
    for skill in "${skills[@]}"; do
      printf '%s\t%s\n' "$source" "$skill" >> "$install_file"
    done
  done <<< "$expanded"

  awk -F '\t' '
    !seen_source[$1]++ { order[++count] = $1 }
    !seen_skill[$1 SUBSEP $2]++ { skills[$1] = skills[$1] " " $2 }
    END {
      for (i = 1; i <= count; i++) {
        source = order[i]
        print source " |" skills[source]
      }
    }
  ' "$install_file" > "$grouped_file"

  while IFS= read -r line || [ -n "$line" ]; do
    source="$(trim "${line%%|*}")"
    skills_part="$(trim "${line#*|}")"
    read -r -a skills <<< "$skills_part"
    npx skills add "$source" --skill "${skills[@]}" --agent "$agent" -y </dev/null
  done < "$grouped_file"

  rm -f "$install_file" "$grouped_file"
}

doctor() {
  local failed=0

  if command -v npx >/dev/null 2>&1; then
    echo "ok: npx found"
  else
    echo "fail: npx not found"
    failed=1
  fi

  if npx skills --help >/dev/null 2>&1; then
    echo "ok: npx skills --help runs"
  else
    echo "fail: npx skills --help failed"
    failed=1
  fi

  if [ -w . ]; then
    echo "ok: current directory is writable"
  else
    echo "fail: current directory is not writable"
    failed=1
  fi

  if [ -d .agents/skills ]; then
    echo "ok: .agents/skills exists"
  else
    echo "warn: .agents/skills missing"
  fi

  if [ -f skills-lock.json ]; then
    echo "ok: skills-lock.json exists"
  else
    echo "warn: skills-lock.json missing"
  fi

  return "$failed"
}

main() {
  local command="${1:-}"
  local profile

  case "$command" in
    list)
      shift
      [ "$#" -eq 0 ] || die "list does not accept arguments"
      list_profiles
      ;;
    show)
      shift
      [ "$#" -eq 1 ] || die "show requires exactly one profile"
      expand_profile "$1"
      ;;
    init|add)
      shift
      [ "$#" -gt 0 ] || die "${command} requires a profile"
      profile="$1"
      shift
      parse_agent_args "$@"
      install_profile "$profile" "$AGENT"
      ;;
    update)
      shift
      [ "$#" -eq 0 ] || die "update does not accept arguments"
      npx skills update -p -y
      ;;
    restore)
      shift
      [ "$#" -eq 0 ] || die "restore does not accept arguments"
      npx skills experimental_install
      ;;
    doctor)
      shift
      [ "$#" -eq 0 ] || die "doctor does not accept arguments"
      doctor
      ;;
    coverage)
      shift
      [ "$#" -eq 0 ] || die "coverage does not accept arguments"
      coverage
      ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
