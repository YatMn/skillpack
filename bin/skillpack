#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  skillpack list
  skillpack show <profile>
  skillpack <profile> --target <target[,target...]>
  skillpack -<profile> --target <target[,target...]>
  skillpack init <profile> --target <target[,target...]>
  skillpack add <profile> --target <target[,target...]>
  skillpack update [--project <path>]
  skillpack restore [--project <path>]
  skillpack doctor [--target <target[,target...]>] [--project <path>]
  skillpack coverage

Targets:
  codex    Install project skills for Codex.
  claude   Install project skills for Claude Code.
  cursor   Install project skills for Cursor.
  all      Install project skills for codex, claude, and cursor.

Project options:
  --project <path>        Install or inspect skills in this project. Defaults to
                          the current working directory.
  --allow-self-install    Allow installing project skills into the skillpack repo.
EOF
}

die() {
  echo "skillpack: $*" >&2
  exit 1
}

resolve_script_path() {
  local source="${BASH_SOURCE[0]}"
  local dir

  while [ -L "$source" ]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    case "$source" in
      /*) ;;
      *) source="${dir}/${source}" ;;
    esac
  done

  cd -P "$(dirname "$source")" && pwd
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

SCRIPT_DIR="$(resolve_script_path)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
PROFILE_DIR="${ROOT_DIR}/profiles"

profile_path() {
  local profile="$1"

  case "$profile" in
    ""|*/*|*..*) die "invalid profile name: ${profile}" ;;
  esac

  printf '%s/%s.yaml' "$PROFILE_DIR" "$profile"
}

require_profile() {
  local profile="$1"
  local path
  if ! path="$(profile_path "$profile")"; then
    return 1
  fi

  [ -f "$path" ] || die "profile not found: ${profile}"
  printf '%s' "$path"
}

list_profiles() {
  local file name

  [ -d "$PROFILE_DIR" ] || die "profile directory not found: ${PROFILE_DIR}"

  for file in "${PROFILE_DIR}"/*.yaml; do
    [ -e "$file" ] || continue
    name="$(basename "$file" .yaml)"
    printf '%s\n' "$name"
  done
}

parse_profile_yaml() {
  local path="$1"

  awk '
    function trim(value) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      return value
    }

    function clean(value) {
      value = trim(value)
      gsub(/^`|`$/, "", value)
      gsub(/^"|"$/, "", value)
      gsub(/^'\''|'\''$/, "", value)
      return value
    }

    function flush_skill() {
      if (source != "") {
        skills = trim(skills)
        if (skills == "") {
          if (saw_names) {
            printf "E\tmissing skills for source %s\n", source
          } else {
            printf "S\t%s\t*\n", source
          }
        } else {
          printf "S\t%s\t%s\n", source, skills
        }
      }
      source = ""
      skills = ""
      saw_names = 0
    }

    /^[[:space:]]*($|#)/ { next }
    /^[[:space:]]*---[[:space:]]*$/ { next }

    /^[^[:space:]][^:]*:[[:space:]]*/ {
      key = $0
      sub(/:.*/, "", key)
      section = key
      in_names = 0

      if (section != "skills") {
        flush_skill()
      }

      next
    }

    section == "includes" && /^[[:space:]]*-[[:space:]]*/ {
      include = $0
      sub(/^[[:space:]]*-[[:space:]]*/, "", include)
      include = clean(include)
      if (include != "" && include != "none") {
        printf "I\t%s\n", include
      }
      next
    }

    section == "skills" && /^[[:space:]]*-[[:space:]]*source:[[:space:]]*/ {
      flush_skill()
      source = $0
      sub(/^[[:space:]]*-[[:space:]]*source:[[:space:]]*/, "", source)
      source = clean(source)
      if (source == "") {
        printf "E\tmissing source\n"
      }
      in_names = 0
      saw_names = 0
      next
    }

    section == "skills" && /^[[:space:]]*names:[[:space:]]*/ {
      in_names = 1
      saw_names = 1
      next
    }

    section == "skills" && in_names && /^[[:space:]]*-[[:space:]]*/ {
      skill = $0
      sub(/^[[:space:]]*-[[:space:]]*/, "", skill)
      skill = clean(skill)
      if (skill != "") {
        skills = skills " " skill
      }
      next
    }

    END {
      flush_skill()
    }
  ' "$path"
}

coverage() {
  local pairs_file catalog_file duplicate_file source_file skill_file includes_file all_source_file
  local source_count skill_count pair_count catalog_count duplicate_count include_error_count all_source_count
  local file profile record_type record_value source skills_part skill

  pairs_file="$(mktemp)"
  catalog_file="$(mktemp)"
  duplicate_file="$(mktemp)"
  source_file="$(mktemp)"
  skill_file="$(mktemp)"
  includes_file="$(mktemp)"
  all_source_file="$(mktemp)"

  for file in "${PROFILE_DIR}"/*.yaml; do
    [ -e "$file" ] || continue
    profile="$(basename "$file" .yaml)"

    while IFS=$'\t' read -r record_type record_value skills_part || [ -n "$record_type" ]; do
      case "$record_type" in
        I)
          if ! require_profile "$record_value" >/dev/null; then
            printf '%s includes missing profile: %s\n' "$profile" "$record_value" >> "$includes_file"
          fi
          ;;
        S)
          source="$record_value"
          [ -n "$source" ] || die "missing source in ${file}"
          [ -n "$skills_part" ] || die "missing skills in ${file}: ${source}"
          if [ "$skills_part" = "*" ]; then
            printf '%s\t%s\n' "$source" "$file" >> "$all_source_file"
            continue
          fi
          for skill in $skills_part; do
            [ -n "$skill" ] && printf '%s\t%s\t%s\n' "$source" "$skill" "$file" >> "$pairs_file"
          done
          ;;
        E)
          die "invalid profile YAML in ${file}: ${record_value}"
          ;;
      esac
    done < <(parse_profile_yaml "$file")
  done

  awk -F '\t' '$1 ~ /^!/ { print $1 " | " $2 }' "$pairs_file" | sort -u > "$catalog_file"
  awk -F '\t' '
    {
      count[$2]++
      lines[$2] = lines[$2] $3 ": " $1 " | " $2 "\n"
    }
    END {
      for (skill in count) {
        if (count[skill] > 1) {
          printf "%s", lines[skill]
        }
      }
    }
  ' "$pairs_file" | sort > "$duplicate_file"
  { awk -F '\t' '$1 !~ /^!/ { print $1 }' "$pairs_file"; awk -F '\t' '$1 !~ /^!/ { print $1 }' "$all_source_file"; } | sort -u > "$source_file"
  awk -F '\t' '{ print $2 }' "$pairs_file" | sort -u > "$skill_file"

  source_count="$(wc -l < "$source_file" | tr -d ' ')"
  skill_count="$(wc -l < "$skill_file" | tr -d ' ')"
  pair_count="$(wc -l < "$pairs_file" | tr -d ' ')"
  catalog_count="$(wc -l < "$catalog_file" | tr -d ' ')"
  duplicate_count="$(wc -l < "$duplicate_file" | tr -d ' ')"
  include_error_count="$(wc -l < "$includes_file" | tr -d ' ')"
  all_source_count="$(wc -l < "$all_source_file" | tr -d ' ')"

  echo "installable sources: ${source_count}"
  echo "profile skills: ${skill_count}"
  echo "source/skill pairs: ${pair_count}"
  echo "catalog-only pairs: ${catalog_count}"
  echo "all-source entries: ${all_source_count}"
  echo "overlap profile skills: ${duplicate_count}"
  echo "missing profile includes: ${include_error_count}"

  if [ "$catalog_count" -gt 0 ]; then
    echo
    echo "Catalog-only pairs:"
    cat "$catalog_file"
  fi

  if [ "$duplicate_count" -gt 0 ]; then
    echo
    echo "Overlap profile skills:"
    cat "$duplicate_file"
  fi

  if [ "$include_error_count" -gt 0 ]; then
    echo
    echo "Missing profile includes:"
    cat "$includes_file"
  fi

  rm -f "$pairs_file" "$catalog_file" "$duplicate_file" "$source_file" "$skill_file" "$includes_file" "$all_source_file"

  [ "$catalog_count" -eq 0 ] && [ "$duplicate_count" -eq 0 ] && [ "$include_error_count" -eq 0 ]
}

expand_profile() {
  local profile="$1"
  local stack="${2:-}"
  local path record_type record_value skills_part source

  case ":${stack}:" in
    *":${profile}:"*) die "profile include cycle: ${stack}:${profile}" ;;
  esac

  if ! path="$(require_profile "$profile")"; then
    return 1
  fi

  while IFS=$'\t' read -r record_type record_value skills_part || [ -n "$record_type" ]; do
    case "$record_type" in
      I)
        if ! expand_profile "$record_value" "${stack}:${profile}"; then
          return 1
        fi
        ;;
      S)
        source="$record_value"
        [ -n "$source" ] || die "missing source in ${path}"
        [ -n "$skills_part" ] || die "missing skills in ${path}: ${source}"
        printf '%s | %s\n' "$source" "$skills_part"
        ;;
      E)
        die "invalid profile YAML in ${path}: ${record_value}"
        ;;
    esac
  done < <(parse_profile_yaml "$path")
}

TARGETS=""
TARGETS_FROM_ALL=0
PROJECT_DIR=""
ALLOW_SELF_INSTALL=0

target_required_message() {
  printf '%s\n' "target is required. Use --target codex,cursor,claude or --target all."
}

target_to_agent() {
  case "$1" in
    codex) printf '%s\n' "codex" ;;
    claude) printf '%s\n' "claude-code" ;;
    cursor) printf '%s\n' "cursor" ;;
    *) die "unknown target: $1" ;;
  esac
}

target_skill_dir() {
  case "$1" in
    codex) printf '%s\n' ".agents/skills" ;;
    claude) printf '%s\n' ".claude/skills" ;;
    cursor) printf '%s\n' ".cursor/skills" ;;
    *) die "unknown target: $1" ;;
  esac
}

append_single_target() {
  local target="$1"

  target="$(trim "$target")"
  [ -n "$target" ] || die "--target contains an empty value"

  case "$target" in
    codex|claude|cursor) ;;
    all)
      [ -z "$TARGETS" ] || die "--target all cannot be combined with other targets"
      TARGETS="codex claude cursor"
      TARGETS_FROM_ALL=1
      return
      ;;
    *) die "unknown target: $target" ;;
  esac

  [ "$TARGETS_FROM_ALL" -eq 0 ] || die "--target all cannot be combined with other targets"

  case " ${TARGETS} " in
    *" ${target} "*) ;;
    *) TARGETS="${TARGETS}${TARGETS:+ }${target}" ;;
  esac
}

append_target_value() {
  local value="$1"
  local remaining target

  value="$(trim "$value")"
  case "$value" in
    ""|,*|*,|*,,*) die "--target contains an empty value" ;;
  esac

  remaining="$value"
  while [ -n "$remaining" ]; do
    case "$remaining" in
      *,*)
        target="${remaining%%,*}"
        remaining="${remaining#*,}"
        ;;
      *)
        target="$remaining"
        remaining=""
        ;;
    esac
    append_single_target "$target"
  done
}

parse_target_args() {
  local required="$1"
  shift

  TARGETS=""
  TARGETS_FROM_ALL=0
  PROJECT_DIR=""
  ALLOW_SELF_INSTALL=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        shift
        [ "$#" -gt 0 ] || die "--target requires a value"
        append_target_value "$1"
        ;;
      --target=*)
        append_target_value "${1#--target=}"
        ;;
      --project)
        shift
        [ "$#" -gt 0 ] || die "--project requires a value"
        PROJECT_DIR="$1"
        ;;
      --project=*)
        PROJECT_DIR="${1#--project=}"
        ;;
      --allow-self-install)
        ALLOW_SELF_INSTALL=1
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
    shift
  done

  if [ -z "$TARGETS" ] && [ "$required" = "required" ]; then
    die "$(target_required_message)"
  fi

  resolve_project_dir
}

resolve_project_dir() {
  local project="${PROJECT_DIR:-.}"

  [ -n "$project" ] || die "--project requires a non-empty path"
  [ -d "$project" ] || die "project directory not found: ${project}"

  PROJECT_DIR="$(cd -P "$project" && pwd)"
}

ensure_not_self_install() {
  if [ "$ALLOW_SELF_INSTALL" -eq 0 ] && [ "$PROJECT_DIR" = "$ROOT_DIR" ]; then
    die "refusing to install project skills into skillpack itself: ${PROJECT_DIR}. Pass --allow-self-install if this is intentional."
  fi
}

install_profile() {
  local profile="$1"
  local targets="$2"
  local expanded line source skills_part install_file grouped_file
  local target agent skill_dir installed_count skipped_count newly_installed before_count after_count
  local -a skills missing_skills still_missing_skills

  if ! expanded="$(expand_profile "$profile")"; then
    return 1
  fi
  [ -n "$expanded" ] || die "profile has no install entries: ${profile}"
  ensure_not_self_install

  install_file="$(mktemp)"
  grouped_file="$(mktemp)"

  while IFS= read -r line || [ -n "$line" ]; do
    source="$(trim "${line%%|*}")"
    skills_part="$(trim "${line#*|}")"
    read -r -a skills <<< "$skills_part"

    [ "${#skills[@]}" -gt 0 ] || die "profile ${profile} has an empty skill list for ${source}"
    case "$source" in
      !*) continue ;;
    esac
    if [ "$skills_part" = "*" ]; then
      printf '%s\t*\n' "$source" >> "$install_file"
      continue
    fi
    for skill in "${skills[@]}"; do
      printf '%s\t%s\n' "$source" "$skill" >> "$install_file"
    done
  done <<< "$expanded"

  awk -F '\t' '
    !seen_source[$1]++ { order[++count] = $1 }
    $2 == "*" { all[$1] = 1; next }
    !seen_skill[$1 SUBSEP $2]++ { skills[$1] = skills[$1] " " $2 }
    END {
      for (i = 1; i <= count; i++) {
        source = order[i]
        if (all[source]) {
          print source " | *"
        } else {
          print source " |" skills[source]
        }
      }
    }
  ' "$install_file" > "$grouped_file"

  while IFS= read -r line || [ -n "$line" ]; do
    source="$(trim "${line%%|*}")"
    skills_part="$(trim "${line#*|}")"
    read -r -a skills <<< "$skills_part"
    [ "${#skills[@]}" -gt 0 ] || die "profile ${profile} has an empty skill list for ${source}"
  done < "$grouped_file"

  [ -s "$grouped_file" ] || die "profile has no installable entries: ${profile}"

  for target in $targets; do
    agent="$(target_to_agent "$target")"
    skill_dir="${PROJECT_DIR}/$(target_skill_dir "$target")"
    mkdir -p "$skill_dir"
    installed_count=0
    skipped_count=0

    echo "Installing ${profile} into ${skill_dir}"

    while IFS= read -r line || [ -n "$line" ]; do
      source="$(trim "${line%%|*}")"
      skills_part="$(trim "${line#*|}")"
      read -r -a skills <<< "$skills_part"
      if [ "$skills_part" = "*" ]; then
        before_count="$(find "$skill_dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
        echo "add: ${source} (all skills)"
        (cd "$PROJECT_DIR" && npx skills add "$source" --agent "$agent" -y </dev/null)
        after_count="$(find "$skill_dir" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
        if [ "$after_count" -gt "$before_count" ]; then
          installed_count=$((installed_count + after_count - before_count))
        fi
        continue
      fi
      missing_skills=()

      for skill in "${skills[@]}"; do
        if [ -f "${skill_dir}/${skill}/SKILL.md" ]; then
          skipped_count=$((skipped_count + 1))
        else
          missing_skills+=("$skill")
        fi
      done

      if [ "${#missing_skills[@]}" -eq 0 ]; then
        echo "skip: ${source} (${#skills[@]} already installed)"
        continue
      fi

      echo "add: ${source} (${#missing_skills[@]} missing, ${#skills[@]} total)"
      (cd "$PROJECT_DIR" && npx skills add "$source" --skill "${missing_skills[@]}" --agent "$agent" -y </dev/null)

      newly_installed=0
      still_missing_skills=()
      for skill in "${missing_skills[@]}"; do
        if [ -f "${skill_dir}/${skill}/SKILL.md" ]; then
          newly_installed=$((newly_installed + 1))
        else
          still_missing_skills+=("$skill")
        fi
      done

      installed_count=$((installed_count + newly_installed))
      if [ "${#still_missing_skills[@]}" -gt 0 ]; then
        die "${source} did not install requested skills: ${still_missing_skills[*]}"
      fi
    done < "$grouped_file"

    echo "summary: installed ${installed_count}, skipped ${skipped_count}"
  done

  rm -f "$install_file" "$grouped_file"
}

doctor() {
  local targets="${1:-}"
  local failed=0
  local target skill_dir

  if command -v npx >/dev/null 2>&1; then
    echo "ok: npx found"
  else
    echo "fail: npx not found"
    failed=1
  fi

  if npx skills --help >/dev/null 2>&1; then
    echo "ok: npx skills --help runs"
  else
    echo "fail: npx skills --help failed"
    failed=1
  fi

  if [ -w "$PROJECT_DIR" ]; then
    echo "ok: project directory is writable: ${PROJECT_DIR}"
  else
    echo "fail: project directory is not writable: ${PROJECT_DIR}"
    failed=1
  fi

  for target in $targets; do
    skill_dir="${PROJECT_DIR}/$(target_skill_dir "$target")"
    if [ -d "$skill_dir" ]; then
      echo "ok: ${skill_dir} exists"
    else
      echo "warn: ${skill_dir} missing"
    fi
  done

  echo "info: skills-lock.json is ignored by skillpack and is not required"

  return "$failed"
}

main() {
  local command="${1:-}"
  local profile

  case "$command" in
    list)
      shift
      [ "$#" -eq 0 ] || die "list does not accept arguments"
      list_profiles
      ;;
    show)
      shift
      [ "$#" -eq 1 ] || die "show requires exactly one profile"
      expand_profile "$1"
      ;;
    init|add)
      shift
      [ "$#" -gt 0 ] || die "${command} requires a profile"
      profile="$1"
      shift
      parse_target_args required "$@"
      install_profile "$profile" "$TARGETS"
      ;;
    update)
      shift
      parse_target_args optional "$@"
      (cd "$PROJECT_DIR" && npx skills update -p -y)
      ;;
    restore)
      shift
      parse_target_args optional "$@"
      echo "warn: restore is legacy. Prefer rerunning skillpack init/add with the desired profiles."
      (cd "$PROJECT_DIR" && npx skills experimental_install)
      ;;
    doctor)
      shift
      parse_target_args optional "$@"
      doctor "$TARGETS"
      ;;
    coverage)
      shift
      [ "$#" -eq 0 ] || die "coverage does not accept arguments"
      coverage
      ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      case "$command" in
        --*)
          profile="${command#--}"
          ;;
        -*)
          profile="${command#-}"
          ;;
        *)
          profile="$command"
          ;;
      esac
      require_profile "$profile" >/dev/null
      shift
      parse_target_args required "$@"
      install_profile "$profile" "$TARGETS"
      ;;
  esac
}

main "$@"
