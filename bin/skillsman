#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  skillsman list
  skillsman show <scenario>
  skillsman status [--target <target[,target...]>] [--project <path>]
  skillsman <scenario> --target <target[,target...]>
  skillsman -<scenario> --target <target[,target...]>
  skillsman init <scenario> --target <target[,target...]>
  skillsman add <scenario> --target <target[,target...]>
  skillsman remove <skill...> --target <target[,target...]>
  skillsman snapshot --target <target[,target...]> [--project <path>] [--output <path>]
  skillsman apply [snapshot-path] --target <target[,target...]> [--project <path>] [--dry-run]
  skillsman update [--project <path>]
  skillsman restore [--project <path>]
  skillsman doctor [--target <target[,target...]>] [--project <path>]
  skillsman coverage

Targets:
  codex       Install project skills for Codex.
  claude      Alias for claude-code.
  claude-code Install project skills for Claude Code.
  cursor      Install project skills for Cursor.
  gemini      Alias for gemini-cli.
  openclaw    Install project skills for OpenClaw.
  antigravity Install project skills for Antigravity.
  all         Pass --agent '*' to npx skills.

  Other target names are passed through to npx skills --agent unchanged.

Project options:
  --project <path>        Install or inspect skills in this project. Defaults to
                          the current working directory.
  --allow-self-install    Allow installing project skills into the skillsman repo.
EOF
}

die() {
  echo "skillsman: $*" >&2
  exit 1
}

resolve_script_path() {
  local source="${BASH_SOURCE[0]}"
  local dir

  while [ -L "$source" ]; do
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    case "$source" in
      /*) ;;
      *) source="${dir}/${source}" ;;
    esac
  done

  cd -P "$(dirname "$source")" && pwd
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

SCRIPT_DIR="$(resolve_script_path)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
SCENARIO_DIR="${ROOT_DIR}/scenarios"
INVOCATION_DIR="$(pwd)"

scenario_path() {
  local scenario="$1"

  case "$scenario" in
    ""|*/*|*..*) die "invalid scenario name: ${scenario}" ;;
  esac

  printf '%s/%s.yaml' "$SCENARIO_DIR" "$scenario"
}

require_scenario() {
  local scenario="$1"
  local path
  if ! path="$(scenario_path "$scenario")"; then
    return 1
  fi

  [ -f "$path" ] || die "scenario not found: ${scenario}"
  printf '%s' "$path"
}

list_scenarios() {
  local file name

  [ -d "$SCENARIO_DIR" ] || die "scenario directory not found: ${SCENARIO_DIR}"

  for file in "${SCENARIO_DIR}"/*.yaml; do
    [ -e "$file" ] || continue
    name="$(basename "$file" .yaml)"
    printf '%s\n' "$name"
  done
}

parse_scenario_yaml() {
  local path="$1"

  awk '
    function trim(value) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      return value
    }

    function clean(value) {
      value = trim(value)
      gsub(/^`|`$/, "", value)
      gsub(/^"|"$/, "", value)
      gsub(/^'\''|'\''$/, "", value)
      return value
    }

    function flush_skill() {
      if (source != "") {
        skills = trim(skills)
        if (skills == "") {
          if (saw_names) {
            printf "E\tmissing skills for source %s\n", source
          } else {
            printf "S\t%s\t*\n", source
          }
        } else {
          printf "S\t%s\t%s\n", source, skills
        }
      }
      source = ""
      skills = ""
      saw_names = 0
    }

    /^[[:space:]]*($|#)/ { next }
    /^[[:space:]]*---[[:space:]]*$/ { next }

    /^[^[:space:]][^:]*:[[:space:]]*/ {
      key = $0
      sub(/:.*/, "", key)
      section = key
      in_names = 0

      if (section != "skills") {
        flush_skill()
      }

      next
    }

    section == "includes" && /^[[:space:]]*-[[:space:]]*/ {
      include = $0
      sub(/^[[:space:]]*-[[:space:]]*/, "", include)
      include = clean(include)
      if (include != "" && include != "none") {
        printf "I\t%s\n", include
      }
      next
    }

    section == "skills" && /^[[:space:]]*-[[:space:]]*source:[[:space:]]*/ {
      flush_skill()
      source = $0
      sub(/^[[:space:]]*-[[:space:]]*source:[[:space:]]*/, "", source)
      source = clean(source)
      if (source == "") {
        printf "E\tmissing source\n"
      }
      in_names = 0
      saw_names = 0
      next
    }

    section == "skills" && /^[[:space:]]*names:[[:space:]]*/ {
      in_names = 1
      saw_names = 1
      next
    }

    section == "skills" && in_names && /^[[:space:]]*-[[:space:]]*/ {
      skill = $0
      sub(/^[[:space:]]*-[[:space:]]*/, "", skill)
      skill = clean(skill)
      if (skill != "") {
        skills = skills " " skill
      }
      next
    }

    END {
      flush_skill()
    }
  ' "$path"
}

coverage() {
  local pairs_file catalog_file duplicate_file source_file skill_file includes_file all_source_file
  local source_count skill_count pair_count catalog_count duplicate_count include_error_count all_source_count
  local file scenario record_type record_value source skills_part skill

  pairs_file="$(mktemp)"
  catalog_file="$(mktemp)"
  duplicate_file="$(mktemp)"
  source_file="$(mktemp)"
  skill_file="$(mktemp)"
  includes_file="$(mktemp)"
  all_source_file="$(mktemp)"

  for file in "${SCENARIO_DIR}"/*.yaml; do
    [ -e "$file" ] || continue
    scenario="$(basename "$file" .yaml)"

    while IFS=$'\t' read -r record_type record_value skills_part || [ -n "$record_type" ]; do
      case "$record_type" in
        I)
          if ! require_scenario "$record_value" >/dev/null; then
            printf '%s includes missing scenario: %s\n' "$scenario" "$record_value" >> "$includes_file"
          fi
          ;;
        S)
          source="$record_value"
          [ -n "$source" ] || die "missing source in ${file}"
          [ -n "$skills_part" ] || die "missing skills in ${file}: ${source}"
          if [ "$skills_part" = "*" ]; then
            printf '%s\t%s\n' "$source" "$file" >> "$all_source_file"
            continue
          fi
          for skill in $skills_part; do
            [ -n "$skill" ] && printf '%s\t%s\t%s\n' "$source" "$skill" "$file" >> "$pairs_file"
          done
          ;;
        E)
          die "invalid scenario YAML in ${file}: ${record_value}"
          ;;
      esac
    done < <(parse_scenario_yaml "$file")
  done

  awk -F '\t' '$1 ~ /^!/ { print $1 " | " $2 }' "$pairs_file" | sort -u > "$catalog_file"
  awk -F '\t' '
    {
      count[$2]++
      lines[$2] = lines[$2] $3 ": " $1 " | " $2 "\n"
    }
    END {
      for (skill in count) {
        if (count[skill] > 1) {
          printf "%s", lines[skill]
        }
      }
    }
  ' "$pairs_file" | sort > "$duplicate_file"
  { awk -F '\t' '$1 !~ /^!/ { print $1 }' "$pairs_file"; awk -F '\t' '$1 !~ /^!/ { print $1 }' "$all_source_file"; } | sort -u > "$source_file"
  awk -F '\t' '{ print $2 }' "$pairs_file" | sort -u > "$skill_file"

  source_count="$(wc -l < "$source_file" | tr -d ' ')"
  skill_count="$(wc -l < "$skill_file" | tr -d ' ')"
  pair_count="$(wc -l < "$pairs_file" | tr -d ' ')"
  catalog_count="$(wc -l < "$catalog_file" | tr -d ' ')"
  duplicate_count="$(wc -l < "$duplicate_file" | tr -d ' ')"
  include_error_count="$(wc -l < "$includes_file" | tr -d ' ')"
  all_source_count="$(wc -l < "$all_source_file" | tr -d ' ')"

  echo "installable sources: ${source_count}"
  echo "scenario skills: ${skill_count}"
  echo "source/skill pairs: ${pair_count}"
  echo "catalog-only pairs: ${catalog_count}"
  echo "all-source entries: ${all_source_count}"
  echo "overlap scenario skills: ${duplicate_count}"
  echo "missing scenario includes: ${include_error_count}"

  if [ "$catalog_count" -gt 0 ]; then
    echo
    echo "Catalog-only pairs:"
    cat "$catalog_file"
  fi

  if [ "$duplicate_count" -gt 0 ]; then
    echo
    echo "Overlap scenario skills:"
    cat "$duplicate_file"
  fi

  if [ "$include_error_count" -gt 0 ]; then
    echo
    echo "Missing scenario includes:"
    cat "$includes_file"
  fi

  rm -f "$pairs_file" "$catalog_file" "$duplicate_file" "$source_file" "$skill_file" "$includes_file" "$all_source_file"

  [ "$catalog_count" -eq 0 ] && [ "$duplicate_count" -eq 0 ] && [ "$include_error_count" -eq 0 ]
}

expand_scenario() {
  local scenario="$1"
  local stack="${2:-}"
  local path record_type record_value skills_part source

  case ":${stack}:" in
    *":${scenario}:"*) die "scenario include cycle: ${stack}:${scenario}" ;;
  esac

  if ! path="$(require_scenario "$scenario")"; then
    return 1
  fi

  while IFS=$'\t' read -r record_type record_value skills_part || [ -n "$record_type" ]; do
    case "$record_type" in
      I)
        if ! expand_scenario "$record_value" "${stack}:${scenario}"; then
          return 1
        fi
        ;;
      S)
        source="$record_value"
        [ -n "$source" ] || die "missing source in ${path}"
        [ -n "$skills_part" ] || die "missing skills in ${path}: ${source}"
        printf '%s | %s\n' "$source" "$skills_part"
        ;;
      E)
        die "invalid scenario YAML in ${path}: ${record_value}"
        ;;
    esac
  done < <(parse_scenario_yaml "$path")
}

TARGETS=""
TARGETS_FROM_ALL=0
PROJECT_DIR=""
ALLOW_SELF_INSTALL=0
SNAPSHOT_PATH=""
DRY_RUN=0
REMOVE_SKILLS=()

target_required_message() {
  printf '%s\n' "target is required. Use --target codex,cursor,claude-code,gemini-cli or --target all."
}

target_to_agent() {
  case "$1" in
    codex) printf '%s\n' "codex" ;;
    claude|claude-code) printf '%s\n' "claude-code" ;;
    cursor) printf '%s\n' "cursor" ;;
    gemini|gemini-cli) printf '%s\n' "gemini-cli" ;;
    openclaw) printf '%s\n' "openclaw" ;;
    antigravity) printf '%s\n' "antigravity" ;;
    all) printf '%s\n' "*" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

target_skill_dir() {
  case "$1" in
    codex|all) printf '%s\n' ".agents/skills" ;;
    claude|claude-code) printf '%s\n' ".claude/skills" ;;
    cursor) printf '%s\n' ".cursor/skills" ;;
    *) return 1 ;;
  esac
}

canonical_target() {
  local target="$1"
  target="$(printf '%s' "$target" | tr '[:upper:]' '[:lower:]')"

  case "$target" in
    gemini) printf '%s\n' "gemini-cli" ;;
    *) printf '%s\n' "$target" ;;
  esac
}

append_single_target() {
  local target="$1"

  target="$(trim "$target")"
  [ -n "$target" ] || die "--target contains an empty value"
  target="$(canonical_target "$target")"

  case "$target" in
    codex|claude|claude-code|cursor|gemini-cli|openclaw|antigravity) ;;
    all)
      [ -z "$TARGETS" ] || die "--target all cannot be combined with other targets"
      TARGETS="all"
      TARGETS_FROM_ALL=1
      return
      ;;
    *)
      echo "warn: target '${target}' is not a built-in alias; passing through to npx skills --agent" >&2
      ;;
  esac

  [ "$TARGETS_FROM_ALL" -eq 0 ] || die "--target all cannot be combined with other targets"

  case " ${TARGETS} " in
    *" ${target} "*) ;;
    *) TARGETS="${TARGETS}${TARGETS:+ }${target}" ;;
  esac
}

append_target_value() {
  local value="$1"
  local remaining target

  value="$(trim "$value")"
  case "$value" in
    ""|,*|*,|*,,*) die "--target contains an empty value" ;;
  esac

  remaining="$value"
  while [ -n "$remaining" ]; do
    case "$remaining" in
      *,*)
        target="${remaining%%,*}"
        remaining="${remaining#*,}"
        ;;
      *)
        target="$remaining"
        remaining=""
        ;;
    esac
    append_single_target "$target"
  done
}

parse_target_args() {
  local required="$1"
  shift

  TARGETS=""
  TARGETS_FROM_ALL=0
  PROJECT_DIR=""
  ALLOW_SELF_INSTALL=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        shift
        [ "$#" -gt 0 ] || die "--target requires a value"
        append_target_value "$1"
        ;;
      --target=*)
        append_target_value "${1#--target=}"
        ;;
      --project)
        shift
        [ "$#" -gt 0 ] || die "--project requires a value"
        PROJECT_DIR="$1"
        ;;
      --project=*)
        PROJECT_DIR="${1#--project=}"
        ;;
      --allow-self-install)
        ALLOW_SELF_INSTALL=1
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
    shift
  done

  if [ -z "$TARGETS" ] && [ "$required" = "required" ]; then
    die "$(target_required_message)"
  fi

  resolve_project_dir
}

parse_remove_args() {
  TARGETS=""
  TARGETS_FROM_ALL=0
  PROJECT_DIR=""
  ALLOW_SELF_INSTALL=0
  REMOVE_SKILLS=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        shift
        [ "$#" -gt 0 ] || die "--target requires a value"
        append_target_value "$1"
        ;;
      --target=*)
        append_target_value "${1#--target=}"
        ;;
      --project)
        shift
        [ "$#" -gt 0 ] || die "--project requires a value"
        PROJECT_DIR="$1"
        ;;
      --project=*)
        PROJECT_DIR="${1#--project=}"
        ;;
      --allow-self-install)
        ALLOW_SELF_INSTALL=1
        ;;
      --*)
        die "unknown argument: $1"
        ;;
      *)
        REMOVE_SKILLS+=("$1")
        ;;
    esac
    shift
  done

  [ "${#REMOVE_SKILLS[@]}" -gt 0 ] || die "remove requires at least one skill name"
  [ -n "$TARGETS" ] || die "$(target_required_message)"

  resolve_project_dir
}

parse_snapshot_args() {
  TARGETS=""
  TARGETS_FROM_ALL=0
  PROJECT_DIR=""
  ALLOW_SELF_INSTALL=0
  SNAPSHOT_PATH=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        shift
        [ "$#" -gt 0 ] || die "--target requires a value"
        append_target_value "$1"
        ;;
      --target=*)
        append_target_value "${1#--target=}"
        ;;
      --project)
        shift
        [ "$#" -gt 0 ] || die "--project requires a value"
        PROJECT_DIR="$1"
        ;;
      --project=*)
        PROJECT_DIR="${1#--project=}"
        ;;
      --output)
        shift
        [ "$#" -gt 0 ] || die "--output requires a value"
        SNAPSHOT_PATH="$1"
        ;;
      --output=*)
        SNAPSHOT_PATH="${1#--output=}"
        ;;
      *)
        die "unknown argument: $1"
        ;;
    esac
    shift
  done

  [ -n "$TARGETS" ] || die "$(target_required_message)"
  resolve_project_dir
  resolve_snapshot_path write
}

parse_apply_args() {
  TARGETS=""
  TARGETS_FROM_ALL=0
  PROJECT_DIR=""
  ALLOW_SELF_INSTALL=0
  SNAPSHOT_PATH=""
  DRY_RUN=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --target)
        shift
        [ "$#" -gt 0 ] || die "--target requires a value"
        append_target_value "$1"
        ;;
      --target=*)
        append_target_value "${1#--target=}"
        ;;
      --project)
        shift
        [ "$#" -gt 0 ] || die "--project requires a value"
        PROJECT_DIR="$1"
        ;;
      --project=*)
        PROJECT_DIR="${1#--project=}"
        ;;
      --dry-run)
        DRY_RUN=1
        ;;
      --allow-self-install)
        ALLOW_SELF_INSTALL=1
        ;;
      --*)
        die "unknown argument: $1"
        ;;
      *)
        [ -z "$SNAPSHOT_PATH" ] || die "apply accepts at most one snapshot path"
        SNAPSHOT_PATH="$1"
        ;;
    esac
    shift
  done

  [ -n "$TARGETS" ] || die "$(target_required_message)"
  resolve_project_dir
  resolve_snapshot_path read
}

resolve_project_dir() {
  local project="${PROJECT_DIR:-.}"

  [ -n "$project" ] || die "--project requires a non-empty path"
  [ -d "$project" ] || die "project directory not found: ${project}"

  PROJECT_DIR="$(cd -P "$project" && pwd)"
}

resolve_snapshot_path() {
  local mode="$1"

  if [ -z "$SNAPSHOT_PATH" ]; then
    SNAPSHOT_PATH="${PROJECT_DIR}/.skillsman/skills.snapshot.yaml"
    return
  fi

  case "$SNAPSHOT_PATH" in
    /*) ;;
    *) SNAPSHOT_PATH="${INVOCATION_DIR}/${SNAPSHOT_PATH}" ;;
  esac

  if [ "$mode" = "read" ]; then
    [ -f "$SNAPSHOT_PATH" ] || die "snapshot file not found: ${SNAPSHOT_PATH}"
  fi
}

ensure_not_self_install() {
  if [ "$ALLOW_SELF_INSTALL" -eq 0 ] && [ "$PROJECT_DIR" = "$ROOT_DIR" ]; then
    die "refusing to modify project skills inside skillsman itself: ${PROJECT_DIR}. Pass --allow-self-install if this is intentional."
  fi
}

target_label() {
  local target="$1"
  local agent skill_dir

  agent="$(target_to_agent "$target")"
  if skill_dir="$(target_skill_dir "$target")"; then
    printf '%s (%s) -> %s\n' "$target" "$agent" "${PROJECT_DIR}/${skill_dir}"
  else
    printf '%s (%s)\n' "$target" "$agent"
  fi
}

skill_installed_for_target() {
  local target="$1"
  local skill="$2"
  local agent skill_dir

  if skill_dir="$(target_skill_dir "$target")" && [ -f "${PROJECT_DIR}/${skill_dir}/${skill}/SKILL.md" ]; then
    return 0
  fi

  agent="$(target_to_agent "$target")"
  { (cd "$PROJECT_DIR" && npx skills list --json --agent "$agent" 2>/dev/null) || printf '[]'; } | node -e '
    const fs = require("fs");
    const wanted = process.argv[1];
    let data = "";
    process.stdin.on("data", chunk => { data += chunk; });
    process.stdin.on("end", () => {
      try {
        const skills = JSON.parse(data);
        process.exit(skills.some(skill => skill && skill.name === wanted) ? 0 : 1);
      } catch {
        process.exit(1);
      }
    });
  ' "$skill"
}

installed_skill_count_for_target() {
  local target="$1"
  local agent skill_dir

  if skill_dir="$(target_skill_dir "$target")" && [ -d "${PROJECT_DIR}/${skill_dir}" ]; then
    find "${PROJECT_DIR}/${skill_dir}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' '
    return
  fi

  agent="$(target_to_agent "$target")"
  { (cd "$PROJECT_DIR" && npx skills list --json --agent "$agent" 2>/dev/null) || printf '[]'; } | node -e '
    let data = "";
    process.stdin.on("data", chunk => { data += chunk; });
    process.stdin.on("end", () => {
      try {
        const skills = JSON.parse(data);
        process.stdout.write(String(Array.isArray(skills) ? skills.length : 0));
      } catch {
        process.stdout.write("0");
      }
    });
  '
}

install_scenario() {
  local scenario="$1"
  local targets="$2"
  local expanded line source skills_part install_file grouped_file
  local target agent skill_dir installed_count skipped_count newly_installed before_count after_count label
  local -a skills missing_skills still_missing_skills

  if ! expanded="$(expand_scenario "$scenario")"; then
    return 1
  fi
  [ -n "$expanded" ] || die "scenario has no install entries: ${scenario}"
  ensure_not_self_install

  install_file="$(mktemp)"
  grouped_file="$(mktemp)"

  while IFS= read -r line || [ -n "$line" ]; do
    source="$(trim "${line%%|*}")"
    skills_part="$(trim "${line#*|}")"
    read -r -a skills <<< "$skills_part"

    [ "${#skills[@]}" -gt 0 ] || die "scenario ${scenario} has an empty skill list for ${source}"
    case "$source" in
      !*) continue ;;
    esac
    if [ "$skills_part" = "*" ]; then
      printf '%s\t*\n' "$source" >> "$install_file"
      continue
    fi
    for skill in "${skills[@]}"; do
      printf '%s\t%s\n' "$source" "$skill" >> "$install_file"
    done
  done <<< "$expanded"

  awk -F '\t' '
    !seen_source[$1]++ { order[++count] = $1 }
    $2 == "*" { all[$1] = 1; next }
    !seen_skill[$1 SUBSEP $2]++ { skills[$1] = skills[$1] " " $2 }
    END {
      for (i = 1; i <= count; i++) {
        source = order[i]
        if (all[source]) {
          print source " | *"
        } else {
          print source " |" skills[source]
        }
      }
    }
  ' "$install_file" > "$grouped_file"

  while IFS= read -r line || [ -n "$line" ]; do
    source="$(trim "${line%%|*}")"
    skills_part="$(trim "${line#*|}")"
    read -r -a skills <<< "$skills_part"
    [ "${#skills[@]}" -gt 0 ] || die "scenario ${scenario} has an empty skill list for ${source}"
  done < "$grouped_file"

  [ -s "$grouped_file" ] || die "scenario has no installable entries: ${scenario}"

  for target in $targets; do
    agent="$(target_to_agent "$target")"
    skill_dir=""
    if skill_dir="$(target_skill_dir "$target")"; then
      skill_dir="${PROJECT_DIR}/${skill_dir}"
      mkdir -p "$skill_dir"
    fi
    installed_count=0
    skipped_count=0
    label="$(target_label "$target")"

    echo "Installing ${scenario} for ${label}"

    while IFS= read -r line || [ -n "$line" ]; do
      source="$(trim "${line%%|*}")"
      skills_part="$(trim "${line#*|}")"
      read -r -a skills <<< "$skills_part"
      if [ "$skills_part" = "*" ]; then
        before_count="$(installed_skill_count_for_target "$target")"
        echo "add: ${source} (all skills)"
        (cd "$PROJECT_DIR" && npx skills add "$source" --agent "$agent" -y </dev/null)
        after_count="$(installed_skill_count_for_target "$target")"
        if [ "$after_count" -gt "$before_count" ]; then
          installed_count=$((installed_count + after_count - before_count))
        fi
        continue
      fi
      missing_skills=()

      for skill in "${skills[@]}"; do
        if skill_installed_for_target "$target" "$skill"; then
          skipped_count=$((skipped_count + 1))
        else
          missing_skills+=("$skill")
        fi
      done

      if [ "${#missing_skills[@]}" -eq 0 ]; then
        echo "skip: ${source} (${#skills[@]} already installed)"
        continue
      fi

      echo "add: ${source} (${#missing_skills[@]} missing, ${#skills[@]} total)"
      (cd "$PROJECT_DIR" && npx skills add "$source" --skill "${missing_skills[@]}" --agent "$agent" -y </dev/null)

      newly_installed=0
      still_missing_skills=()
      for skill in "${missing_skills[@]}"; do
        if skill_installed_for_target "$target" "$skill"; then
          newly_installed=$((newly_installed + 1))
        else
          still_missing_skills+=("$skill")
        fi
      done

      installed_count=$((installed_count + newly_installed))
      if [ "${#still_missing_skills[@]}" -gt 0 ]; then
        die "${source} did not install requested skills: ${still_missing_skills[*]}"
      fi
    done < "$grouped_file"

    echo "summary: installed ${installed_count}, skipped ${skipped_count}"
  done

  rm -f "$install_file" "$grouped_file"
}

remove_skills() {
  local targets="$1"
  local target labels label

  ensure_not_self_install

  echo "warn: consider running skillsman snapshot before removing project skills" >&2

  labels=""
  for target in $targets; do
    label="$(target_label "$target")"
    labels="${labels}${labels:+, }${label}"
  done

  echo "Removing ${REMOVE_SKILLS[*]} from project skills for target request: ${labels}"
  (cd "$PROJECT_DIR" && npx skills remove "${REMOVE_SKILLS[@]}" -y </dev/null)
}

status_skills() {
  local targets="${1:-}"
  local target agent

  if [ -z "$targets" ]; then
    (cd "$PROJECT_DIR" && npx skills list)
    return
  fi

  for target in $targets; do
    agent="$(target_to_agent "$target")"
    echo "Project skills for ${target} (${agent}):"
    (cd "$PROJECT_DIR" && npx skills list --agent "$agent")
  done
}

doctor() {
  local targets="${1:-}"
  local failed=0
  local target agent skill_dir

  if command -v npx >/dev/null 2>&1; then
    echo "ok: npx found"
  else
    echo "fail: npx not found"
    failed=1
  fi

  if npx skills --help >/dev/null 2>&1; then
    echo "ok: npx skills --help runs"
  else
    echo "fail: npx skills --help failed"
    failed=1
  fi

  if [ -w "$PROJECT_DIR" ]; then
    echo "ok: project directory is writable: ${PROJECT_DIR}"
  else
    echo "fail: project directory is not writable: ${PROJECT_DIR}"
    failed=1
  fi

  for target in $targets; do
    agent="$(target_to_agent "$target")"
    if (cd "$PROJECT_DIR" && npx skills list --json --agent "$agent" >/dev/null 2>&1); then
      echo "ok: npx skills list works for target ${target} (${agent})"
    else
      echo "warn: npx skills list failed for target ${target} (${agent})"
    fi
    if skill_dir="$(target_skill_dir "$target")"; then
      skill_dir="${PROJECT_DIR}/${skill_dir}"
      if [ -d "$skill_dir" ]; then
        echo "ok: ${skill_dir} exists"
      else
        echo "warn: ${skill_dir} missing"
      fi
    else
      echo "info: ${target} has no Skillsman-maintained local directory mapping"
    fi
  done

  echo "info: skills-lock.json is ignored by skillsman and is not required"

  return "$failed"
}

lock_source_for_skill() {
  local lock_file="$1"
  local skill="$2"

  [ -f "$lock_file" ] || return 1
  command -v node >/dev/null 2>&1 || return 1

  node -e '
    const fs = require("fs");
    const lock = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    const skill = process.argv[2];
    const entry = lock.skills && lock.skills[skill];
    if (!entry || typeof entry.source !== "string" || entry.source.length === 0) {
      process.exit(1);
    }
    process.stdout.write(entry.source);
  ' "$lock_file" "$skill"
}

write_snapshot() {
  local output="$1"
  local targets="$2"
  local target skill_dir skill_path skill source lock_file
  local missing_file snapshot_tmp
  local found_count=0

  lock_file="${PROJECT_DIR}/skills-lock.json"
  missing_file="$(mktemp)"
  snapshot_tmp="$(mktemp)"

  {
    echo "schema: skillsman.snapshot.v1"
    echo "targets:"

    for target in $targets; do
      if ! skill_dir="$(target_skill_dir "$target")"; then
        rm -f "$missing_file" "$snapshot_tmp"
        die "snapshot requires a target with a known project skill directory: ${target}"
      fi
      skill_dir="${PROJECT_DIR}/${skill_dir}"
      echo "  ${target}:"
      echo "    skills:"

      if [ ! -d "$skill_dir" ]; then
        continue
      fi

      while IFS= read -r skill_path || [ -n "$skill_path" ]; do
        skill="$(basename "$(dirname "$skill_path")")"
        if source="$(lock_source_for_skill "$lock_file" "$skill")"; then
          echo "      - name: ${skill}"
          echo "        source: ${source}"
          found_count=$((found_count + 1))
        else
          printf '%s\n' "$skill" >> "$missing_file"
        fi
      done < <(find "$skill_dir" -mindepth 2 -maxdepth 2 -type f -name SKILL.md | sort)
    done
  } > "$snapshot_tmp"

  if [ -s "$missing_file" ]; then
    echo "skillsman: snapshot cannot resolve source for installed skills:" >&2
    sed 's/^/  - /' "$missing_file" >&2
    echo "skillsman: ensure skills-lock.json has matching source metadata" >&2
    rm -f "$missing_file" "$snapshot_tmp"
    exit 1
  fi

  mkdir -p "$(dirname "$output")"
  mv "$snapshot_tmp" "$output"
  rm -f "$missing_file"

  echo "Snapshot written to ${output}"
  echo "summary: captured ${found_count} skills"
}

parse_snapshot_yaml() {
  local path="$1"

  awk '
    function trim(value) {
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      return value
    }

    /^schema:[[:space:]]*/ {
      schema = $0
      sub(/^schema:[[:space:]]*/, "", schema)
      if (schema != "skillsman.snapshot.v1") {
        printf "E\tunsupported snapshot schema: %s\n", schema
      }
      next
    }

    /^[[:space:]]{2}[[:alnum:]_-]+:[[:space:]]*$/ {
      target = trim($0)
      sub(/:$/, "", target)
      printf "T\t%s\n", target
      next
    }

    /^[[:space:]]*-[[:space:]]*name:[[:space:]]*/ {
      name = $0
      sub(/^[[:space:]]*-[[:space:]]*name:[[:space:]]*/, "", name)
      next
    }

    /^[[:space:]]*source:[[:space:]]*/ {
      source = $0
      sub(/^[[:space:]]*source:[[:space:]]*/, "", source)
      if (target == "" || name == "" || source == "") {
        printf "E\tinvalid snapshot skill entry\n"
      } else {
        printf "S\t%s\t%s\t%s\n", target, name, source
      }
      name = ""
      source = ""
      next
    }
  ' "$path"
}

apply_snapshot() {
  local path="$1"
  local targets="$2"
  local record_file install_file grouped_file
  local record_type target skill source wanted agent skill_dir
  local installed_count skipped_count newly_installed
  local line skills_part
  local -a skills missing_skills still_missing_skills

  ensure_not_self_install
  [ -f "$path" ] || die "snapshot file not found: ${path}"

  record_file="$(mktemp)"
  install_file="$(mktemp)"
  grouped_file="$(mktemp)"

  while IFS=$'\t' read -r record_type target skill source || [ -n "$record_type" ]; do
    case "$record_type" in
      T)
        case " ${targets} " in
          *" ${target} "*) printf 'T\t%s\t\t\n' "$target" >> "$record_file" ;;
        esac
        ;;
      S)
        case " ${targets} " in
          *" ${target} "*) printf 'S\t%s\t%s\t%s\n' "$target" "$skill" "$source" >> "$record_file" ;;
        esac
        ;;
      E)
        rm -f "$record_file" "$install_file" "$grouped_file"
        die "invalid snapshot ${path}: ${target}"
        ;;
    esac
  done < <(parse_snapshot_yaml "$path")

  for wanted in $targets; do
    if ! awk -F '\t' -v wanted="$wanted" '$2 == wanted { found = 1 } END { exit found ? 0 : 1 }' "$record_file"; then
      rm -f "$record_file" "$install_file" "$grouped_file"
      die "snapshot has no skills for target: ${wanted}"
    fi
  done

  for target in $targets; do
    agent="$(target_to_agent "$target")"
    if ! skill_dir="$(target_skill_dir "$target")"; then
      rm -f "$record_file" "$install_file" "$grouped_file"
      die "apply requires a target with a known project skill directory: ${target}"
    fi
    skill_dir="${PROJECT_DIR}/${skill_dir}"
    if [ "$DRY_RUN" -eq 0 ]; then
      mkdir -p "$skill_dir"
    fi
    installed_count=0
    skipped_count=0
    : > "$install_file"
    : > "$grouped_file"

    echo "Applying ${path} into ${skill_dir}"

    while IFS=$'\t' read -r _ _ skill source || [ -n "$skill" ]; do
      if skill_installed_for_target "$target" "$skill"; then
        skipped_count=$((skipped_count + 1))
      else
        printf '%s\t%s\n' "$source" "$skill" >> "$install_file"
      fi
    done < <(awk -F '\t' -v target="$target" '$1 == "S" && $2 == target { print $1 "\t" $2 "\t" $3 "\t" $4 }' "$record_file")

    awk -F '\t' '
      !seen_source[$1]++ { order[++count] = $1 }
      !seen_skill[$1 SUBSEP $2]++ { skills[$1] = skills[$1] " " $2 }
      END {
        for (i = 1; i <= count; i++) {
          source = order[i]
          print source " |" skills[source]
        }
      }
    ' "$install_file" > "$grouped_file"

    while IFS= read -r line || [ -n "$line" ]; do
      source="$(trim "${line%%|*}")"
      skills_part="$(trim "${line#*|}")"
      read -r -a skills <<< "$skills_part"
      [ "${#skills[@]}" -gt 0 ] || continue

      if [ "$DRY_RUN" -eq 1 ]; then
        echo "dry-run add: ${source} (${#skills[@]} missing)"
        installed_count=$((installed_count + ${#skills[@]}))
        continue
      fi

      echo "add: ${source} (${#skills[@]} missing)"
      (cd "$PROJECT_DIR" && npx skills add "$source" --skill "${skills[@]}" --agent "$agent" -y </dev/null)

      newly_installed=0
      still_missing_skills=()
      for skill in "${skills[@]}"; do
        if skill_installed_for_target "$target" "$skill"; then
          newly_installed=$((newly_installed + 1))
        else
          still_missing_skills+=("$skill")
        fi
      done

      installed_count=$((installed_count + newly_installed))
      if [ "${#still_missing_skills[@]}" -gt 0 ]; then
        rm -f "$record_file" "$install_file" "$grouped_file"
        die "${source} did not install requested skills: ${still_missing_skills[*]}"
      fi
    done < "$grouped_file"

    if [ ! -s "$grouped_file" ]; then
      echo "skip: ${target} (${skipped_count} already installed)"
    fi

    if [ "$DRY_RUN" -eq 1 ]; then
      echo "summary: would install ${installed_count}, skipped ${skipped_count}"
    else
      echo "summary: installed ${installed_count}, skipped ${skipped_count}"
    fi
  done

  rm -f "$record_file" "$install_file" "$grouped_file"
}

main() {
  local command="${1:-}"
  local scenario

  case "$command" in
    list)
      shift
      [ "$#" -eq 0 ] || die "list does not accept arguments"
      list_scenarios
      ;;
    show)
      shift
      [ "$#" -eq 1 ] || die "show requires exactly one scenario"
      expand_scenario "$1"
      ;;
    status)
      shift
      parse_target_args optional "$@"
      status_skills "$TARGETS"
      ;;
    init|add)
      shift
      [ "$#" -gt 0 ] || die "${command} requires a scenario"
      scenario="$1"
      shift
      parse_target_args required "$@"
      install_scenario "$scenario" "$TARGETS"
      ;;
    remove)
      shift
      parse_remove_args "$@"
      remove_skills "$TARGETS"
      ;;
    snapshot)
      shift
      parse_snapshot_args "$@"
      write_snapshot "$SNAPSHOT_PATH" "$TARGETS"
      ;;
    apply)
      shift
      parse_apply_args "$@"
      apply_snapshot "$SNAPSHOT_PATH" "$TARGETS"
      ;;
    update)
      shift
      parse_target_args optional "$@"
      ensure_not_self_install
      (cd "$PROJECT_DIR" && npx skills update -p -y)
      ;;
    restore)
      shift
      parse_target_args optional "$@"
      ensure_not_self_install
      echo "warn: restore is legacy. Prefer rerunning skillsman init/add with the desired scenarios."
      (cd "$PROJECT_DIR" && npx skills experimental_install)
      ;;
    doctor)
      shift
      parse_target_args optional "$@"
      doctor "$TARGETS"
      ;;
    coverage)
      shift
      [ "$#" -eq 0 ] || die "coverage does not accept arguments"
      coverage
      ;;
    -h|--help|help|"")
      usage
      ;;
    *)
      case "$command" in
        --*)
          scenario="${command#--}"
          ;;
        -*)
          scenario="${command#-}"
          ;;
        *)
          scenario="$command"
          ;;
      esac
      require_scenario "$scenario" >/dev/null
      shift
      parse_target_args required "$@"
      install_scenario "$scenario" "$TARGETS"
      ;;
  esac
}

main "$@"
